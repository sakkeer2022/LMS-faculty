# REQUIRED. Backend API origin. The Next /api/v1 rewrite proxies to it so auth cookies stay same-origin.
# Hosting (Vercel): set this in the project's Environment Variables for every environment and redeploy
# after changing it; the rewrite is fixed at build time. Use the backend's public https origin with
# no trailing slash and no /api/v1 (for QA, the Render URL).
BACKEND_ORIGIN=http://127.0.0.1:3000
# Optional. Public marketing site; the onboarding "back to home" link. Falls back to /login.
NEXT_PUBLIC_SITE_URL=
